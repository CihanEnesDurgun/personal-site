# Sunucu baglanti ayarlari (content:pull / content:push / backup:data icin).
#
# Kullanim:  cp deploy.config.example deploy.config   ve degerleri doldur.
# deploy.config gitignore'dadir — sunucu bilgilerin repo'ya sizmaz.
#
# Bu degerleri cPanel > SSH Access ekraninda bulabilirsin.

# SSH sunucu adresi (cPanel'in adresi; genelde sunucu hostname'i veya domain)
CPANEL_HOST=sunucu.hostingfirmasi.com

# cPanel kullanici adin
CPANEL_USER=kullaniciadi

# SSH portu — cogu hosting 22 kullanir, bazilari degistirir (orn. 2222)
CPANEL_SSH_PORT=22

# Sunucudaki uygulama klasoru = cPanel > Setup Node.js App > "Application root"
# .cpanel.yml icindeki APP_DIR ile AYNI olmali.
CPANEL_APP_DIR=/home/kullaniciadi/personal-site
