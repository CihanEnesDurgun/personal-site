# ============================================================
#  .env ORNEK DOSYASI
#  Kopyala:  cp env.example .env    ve degerleri kendine gore doldur.
#
#  !!! ASLA gercek deger yazma !!!  Bu dosya git'te durur ve repo PUBLIC'tir.
#  Gercek degerler yalnizca .env icinde yasar (.env gitignore'dadir).
# ============================================================

# ---------- ZORUNLU (yoksa uygulama baslamaz) ----------

# JWT_SECRET: admin oturum token'larini imzalar. En az 32 karakter.
# Bunu bilen kisi sifre bilmeden admin olabilir — gizli tut, git'e yazma.
# Uret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# BCRYPT_SALT_ROUNDS: sifre hash maliyeti. Gecerli aralik 10-15, onerilen 12.
BCRYPT_SALT_ROUNDS=12


# ---------- ORTAM ----------

# NODE_ENV: production | development
# ONEMLI: production disinda rate limiting KAPALI ve CSP gevsek modda calisir.
# Sunucudaki .env'de MUTLAKA production olmali.
NODE_ENV=development

# PORT: yerel gelistirme icin. cPanel/Passenger bu degeri kendisi atar, orada onemsiz.
PORT=3000


# ---------- OTURUM (dakika) ----------

# SESSION_TIMEOUT: oturumun toplam omru. SESSION_IDLE_TIMEOUT'tan buyuk olmali.
SESSION_TIMEOUT=480

# SESSION_IDLE_TIMEOUT: hareketsizlik suresi; bu sure istek gelmezse oturum duser.
SESSION_IDLE_TIMEOUT=90

# MAX_SESSIONS_PER_USER: ayni kullanici icin es zamanli oturum sayisi.
MAX_SESSIONS_PER_USER=3

# SESSION_CLEANUP_INTERVAL: suresi dolmus oturumlarin temizlenme sikligi (dakika).
SESSION_CLEANUP_INTERVAL=5


# ---------- SITE / GUVENLIK ----------

# SITE_URL: sitenin canli adresi. Bos birakilirsa https://cihanenesdurgun.com kullanilir.
# CORS ve ayni-domain kontrolleri bu degerden turetilir.
SITE_URL=https://cihanenesdurgun.com

# CORS_ORIGIN: virgulle ayrilmis izinli origin listesi.
# Bos birakilirsa SITE_URL + www varyanti + localhost otomatik kullanilir.
# Cogu durumda bos birakmak dogrudur.
CORS_ORIGIN=

# RATE_LIMIT_MAX: 15 dakikalik pencerede IP basina istek limiti.
# Bos ise: production'da 1000, development'ta 100000.
RATE_LIMIT_MAX=1000


# ---------- ILK KURULUM ----------

# DEFAULT_ADMIN_PASSWORD: `npm run setup:users` bu sifreyle data/users.json uretir.
# En az 12 karakter. Admin olusturulduktan sonra bu satiri silebilirsin.
# Uret: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DEFAULT_ADMIN_PASSWORD=


# ---------- OPSIYONEL ----------

# LOG_LEVEL: error | warn | info | debug
LOG_LEVEL=info

# GITHUB_TOKEN: yalnizca GitHub API rate limitine takiliyorsan gerekir (public repo
# verisi cekilirken). Bos birakilabilir.
GITHUB_TOKEN=
